<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Extract DE Fields Metadata</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    h1 { color: #003366; }
    form { margin-bottom: 30px; padding: 20px; border: 1px solid #ccc; width: 400px; }
    label, input, select, button { display: block; margin-top: 10px; width: 100%; }
    table { border-collapse: collapse; width: 100%; margin-top: 30px; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    th { background-color: #f2f2f2; }
    .download-button { margin-top: 20px; }
    #inputFeedback { font-size: 0.9em; color: red; margin-top: 4px; }
  </style>
</head>
<body>
  <h1>Extract DE Fields Metadata</h1>

  <form method="GET" onsubmit="return validateInput()">
    <label for="identifier"><strong>Enter a Data Extension name or a folder Category ID:</strong></label>
    <input type="text" name="identifier" id="identifier" value="%%=v(RequestParameter("identifier"))=%%" required>
    <small id="inputFeedback"></small>
    <button type="submit">Process</button>
  </form>

  <div id="resultsContainer">
  <script runat="server">
    Platform.Load("Core", "1.1");

    var identifier = Request.GetQueryStringParameter("identifier");

    function isNumeric(str) {
      return /^\d+$/.test(str);
    }

    if (identifier) {
      var des = [];

      if (isNumeric(identifier)) {
        des = DataExtension.Retrieve({
          Property: "CategoryID",
          SimpleOperator: "equals",
          Value: parseInt(identifier)
        });
      } else {
        des = DataExtension.Retrieve({
          Property: "Name",
          SimpleOperator: "equals",
          Value: identifier
        });
      }

      if (des && des.length > 0) {
        Write('<button class="download-button" onclick="downloadTableAsCSV()">Download CSV</button>');
        Write("<table id='deTable'><tr><th>DE Name</th><th>Customer Key</th><th>Field Name</th><th>Field Type</th><th>Max Length</th><th>Is Primary Key</th><th>Is Nullable</th><th>Row Count</th></tr>");

        for (var i = 0; i < des.length; i++) {
          var de = des[i];
          var deName = de.Name;
          var deKey = de.CustomerKey;

          Platform.Variable.SetValue("@deName", deName);
  </script>

  %%[
    SET @rowCount = DataExtensionRowCount(@deName)
  ]%%

  <script runat="server">
          var rowCount = Variable.GetValue("@rowCount");
          if (!rowCount || rowCount === "") {
            rowCount = "Unavailable";
          }

          try {
            var myDE = DataExtension.Init(deKey);
            var fields = myDE.Fields.Retrieve();

            if (fields && fields.length > 0) {
              for (var j = 0; j < fields.length; j++) {
                var f = fields[j];
                Write("<tr>" +
                  "<td>" + deName + "</td>" +
                  "<td>" + deKey + "</td>" +
                  "<td>" + f.Name + "</td>" +
                  "<td>" + f.FieldType + "</td>" +
                  "<td>" + (f.MaxLength || "") + "</td>" +
                  "<td>" + (f.IsPrimaryKey === true ? "Yes" : "") + "</td>" +
                  "<td>" + (f.IsNullable === true ? "Yes" : "No") + "</td>" +
                  "<td>" + rowCount + "</td>" +
                  "</tr>");
              }
            } else {
              Write("<tr><td colspan='8'><em>No fields found for DE: " + deName + "</em></td></tr>");
            }
          } catch (e) {
            Write("<tr><td colspan='8' style='color:red;'>Error retrieving fields for DE: " + deName + " - " + String(e) + "</td></tr>");
          }
        }
        Write("</table>");
      } else {
        Write("<p style='color:red;'>⚠️ No Data Extensions found for the given identifier.</p>");
      }
    }
  </script>
  </div>

  <script>
    function validateInput() {
      const input = document.getElementById("identifier").value.trim();
      const feedback = document.getElementById("inputFeedback");

      if (input === "") {
        feedback.textContent = "Field cannot be empty.";
        return false;
      } else if (!/^[\w\s\-]+$/.test(input)) {
        feedback.textContent = "Invalid characters. Use only letters, numbers, dashes and spaces.";
        return false;
      } else {
        feedback.textContent = "";
        return true;
      }
    }

    function downloadTableAsCSV() {
      const identifier = document.getElementById("identifier").value.trim();
      const today = new Date();
      const yyyymmdd = today.getFullYear().toString()
        + String(today.getMonth() + 1).padStart(2, '0')
        + String(today.getDate()).padStart(2, '0');

      let filename = "";
      if (/^\d+$/.test(identifier)) {
        filename = `DE_category_${identifier}_metadata_${yyyymmdd}.csv`;
      } else {
        const safeName = identifier.replace(/[^a-zA-Z0-9_-]/g, "_");
        filename = `${safeName}_metadata_${yyyymmdd}.csv`;
      }

      const table = document.getElementById("deTable");
      const rows = table.querySelectorAll("tr");
      let csvContent = "";
      rows.forEach(row => {
        let cols = row.querySelectorAll("td, th");
        let line = Array.from(cols).map(col => '"' + col.innerText.replace(/"/g, '""') + '"').join(",");
        csvContent += line + "\n";
      });
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = filename;
      link.click();
    }
  </script>
</body>
</html>